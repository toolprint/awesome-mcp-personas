{
  "mcpServers": {
    "mysql": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mysql-mcp-server"],
      "env": {
        "MYSQL_HOST": "<placeholder>",
        "MYSQL_PORT": "<placeholder>",
        "MYSQL_DATABASE": "<placeholder>",
        "MYSQL_USER": "<placeholder>",
        "MYSQL_PASSWORD": "<placeholder>"
      }
    },
    "chart": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@antvis/mcp-server-chart"]
    },
    "vchart": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@visactor/vchart-mcp-server"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "env": {
        "ALLOWED_DIRECTORIES": "<placeholder>"
      }
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git"]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "time": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-time"],
      "env": {
        "DEFAULT_TIMEZONE": "<placeholder>"
      }
    }
  }
}