{
  "mcpServers": {
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ]
    },
    "docker": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ]
    },
    "slack": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "slack-mcp-server"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "<placeholder>",
        "SLACK_TEAM_ID": "<placeholder>"
      }
    }
  }
}