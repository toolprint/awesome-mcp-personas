{
  "mcpServers": {
    "git": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ]
    },
    "slack": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "slack-mcp-server"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "<placeholder>"
      }
    }
  }
}